{
  "name": "@vyrel/bun-porting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./image": "./src/image/bun-image.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./internal/runner": "./src/internal/runner.ts",
    "./internal/protocol": "./src/internal/protocol.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "effect:codegen": "effect-language-service codegen --project tsconfig.json",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json --format text",
    "effect:overview": "effect-language-service overview --project tsconfig.json",
    "effect:quickfixes": "effect-language-service quickfixes --project tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@vyrel/logging": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@vyrel/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
