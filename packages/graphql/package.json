{
  "name": "@vyrel/graphql",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-effect-ts": "effect-language-service diagnostics --project tsconfig.json --format text",
    "check-types": "tsc --noEmit",
    "gen": "bun run gen-imports && bun run gen-schema",
    "gen-imports": "bun run scripts/collect-graphql-imports.ts",
    "gen-schema": "bun run scripts/gen-schema.ts"
  },
  "dependencies": {
    "@graphql-yoga/plugin-apq": "^3.21.2",
    "@pothos/core": "catalog:",
    "@pothos/plugin-dataloader": "catalog:",
    "@pothos/plugin-drizzle": "catalog:",
    "@pothos/plugin-relay": "catalog:",
    "@pothos/plugin-scope-auth": "catalog:",
    "@pothos/plugin-validation": "catalog:",
    "@pothos/plugin-with-input": "catalog:",
    "@vyrel/auth": "workspace:*",
    "@vyrel/db": "workspace:*",
    "@vyrel/logging": "workspace:*",
    "@vyrel/morph": "workspace:*",
    "@whatwg-node/fetch": "^0.10.13",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "catalog:",
    "elysia": "catalog:",
    "graphql": "catalog:",
    "graphql-scalars": "catalog:",
    "graphql-yoga": "catalog:"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@vyrel/config": "workspace:*",
    "typescript": "catalog:"
  }
}
