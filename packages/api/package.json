{
  "name": "@vyrel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "effect:codegen": "effect-language-service codegen --project tsconfig.json",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json --format text",
    "effect:overview": "effect-language-service overview --project tsconfig.json",
    "effect:quickfixes": "effect-language-service quickfixes --project tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vyrel/auth": "workspace:*",
    "@vyrel/bun-porting": "workspace:*",
    "@vyrel/db": "workspace:*",
    "@vyrel/env": "workspace:*",
    "@vyrel/graphql": "workspace:*",
    "@vyrel/logging": "workspace:*",
    "@vyrel/morph": "workspace:*",
    "@vyrel/storage": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "elysia": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@playwright/test": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vyrel/config": "workspace:*",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
