{
  "name": "@vyrel/morph",
  "version": "0.0.4",
  "description": "Vyrel morph",
  "keywords": [
    "graphql",
    "pothos",
    "zod",
    "drizzle",
    "typescript",
    "schema",
    "codegen"
  ],
  "homepage": "https://github.com/FlavioScimeca/vyrel/tree/main/packages/public/morph",
  "bugs": {
    "url": "https://github.com/FlavioScimeca/vyrel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FlavioScimeca/vyrel.git",
    "directory": "packages/public/morph"
  },
  "license": "MIT",
  "author": "Flavio Scimeca",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run script/compiler.ts",
    "build:analyze": "ANALYZE=1 bun run script/compiler.ts",
    "build:verified": "bun run script/build.ts",
    "check": "ultracite check",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "fix": "ultracite fix",
    "format": "ultracite fix",
    "knip": "knip",
    "lint": "ultracite check",
    "prepublishOnly": "bun run build:verified",
    "size": "bun run script/size.ts",
    "test": "vitest run --passWithNoTests",
    "validate": "bun run script/verify.ts"
  },
  "devDependencies": {
    "@pothos/core": "catalog:",
    "@pothos/plugin-validation": "catalog:",
    "@pothos/plugin-with-input": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vyrel/config": "workspace:*",
    "knip": "^6.25.0",
    "typescript": "catalog:",
    "ultracite": "7.9.2",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@pothos/core": "^4.13.0",
    "@pothos/plugin-validation": "^4.3.0",
    "@pothos/plugin-with-input": "^4.1.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  }
}
