{
  "name": "@vyrel/morph",
  "version": "0.0.1",
  "description": "Vyrel morph",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlavioScimeca/vyrel.git",
    "directory": "packages/public/morph"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pothos": {
      "types": "./dist/pothos.d.ts",
      "import": "./dist/pothos.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run script/compiler.ts",
    "build:analyze": "ANALYZE=1 bun run script/compiler.ts",
    "build:verified": "bun run script/build.ts",
    "validate": "bun run script/verify.ts",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "size": "bun run script/size.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@pothos/core": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@pothos/plugin-validation": "catalog:",
    "@pothos/plugin-with-input": "catalog:"
  },
  "devDependencies": {
    "@pothos/plugin-validation": "catalog:",
    "@pothos/plugin-with-input": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vyrel/config": "workspace:*",
    "knip": "^6.25.0",
    "typescript": "catalog:",
    "ultracite": "7.9.3",
    "vitest": "catalog:"
  }
}
