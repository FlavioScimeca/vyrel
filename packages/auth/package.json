{
  "name": "@vyrel/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./emails/*": {
      "default": "./src/emails/*.tsx"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check-effect-ts": "effect-language-service diagnostics --project tsconfig.json --format text",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/expo": "^1.6.25",
    "@react-email/components": "^1.0.12",
    "@vyrel/consts": "workspace:*",
    "@vyrel/db": "workspace:*",
    "@vyrel/env": "workspace:*",
    "@vyrel/logging": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "jose": "^6.2.3",
    "react": "catalog:",
    "resend": "^6.16.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/react": "catalog:",
    "@vyrel/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
