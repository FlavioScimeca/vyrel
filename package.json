{
  "name": "vyrel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/public/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "elysia": "^1.4.29",
      "better-auth": "^1.6.22",
      "graphql-yoga": "^5.21.2",
      "graphql": "^16.11.0",
      "@pothos/core": "^4.13.0",
      "@pothos/plugin-dataloader": "^4.4.4",
      "@pothos/plugin-drizzle": "^0.17.4",
      "@effect/platform-bun": "^0.90.0",
      "@pothos/plugin-relay": "^4.7.0",
      "@pothos/plugin-scope-auth": "^4.1.6",
      "@pothos/plugin-validation": "^4.3.0",
      "@pothos/plugin-with-input": "^4.1.4",
      "react": "^19.2.7",
      "effect": "^3.21.4",
      "graphql-scalars": "^1.25.0",
      "@effect/platform": "^0.96.2",
      "@types/react": "^19.2.17",
      "msw": "^2.14.6",
      "@effect/vitest": "^0.29.0",
      "vitest": "4.1.8",
      "@vitest/ui": "4.1.8",
      "react-doctor": "^0.8.1",
      "@vitest/coverage-v8": "4.1.8",
      "jsdom": "^29.1.1",
      "@playwright/test": "^1.61.1",
      "playwright": "^1.61.1",
      "next": "^16.2.9",
      "react-dom": "^19.2.7",
      "@libsql/client": "^0.17.4",
      "libsql": "^0.5.29",
      "@tailwindcss/postcss": "^4.3.1",
      "evlog": "^2.22.1",
      "tailwindcss": "^4.3.1",
      "tailwind-merge": "^3.4.0",
      "@types/node": "^26.0.1",
      "@types/react-dom": "^19.2.3",
      "@effect/language-service": "^0.86.4",
      "typescript": "npm:typescript@^7.0.2",
      "typescript6": "npm:typescript@^6.0.3"
    }
  },
  "scripts": {
    "build": "bun run script/swap-typescript-for-vercel.ts && turbo build",
    "build:docs": "turbo -F docs build",
    "changeset": "changeset",
    "check:docs": "turbo -F docs check-types",
    "check:effect-ts": "effect-language-service diagnostics --project tsconfig.json --format text && turbo check-effect-ts",
    "check-types": "turbo check-types",
    "commit": "bun run script/commit.ts",
    "db:generate": "turbo -F @vyrel/db db:generate",
    "db:local": "turbo -F @vyrel/db db:local",
    "db:migrate": "turbo -F @vyrel/db db:migrate",
    "db:push": "turbo -F @vyrel/db db:push",
    "db:studio": "turbo -F @vyrel/db db:studio",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "deps:format:check": "syncpack format --check",
    "deps:lint": "syncpack lint",
    "deps:list": "syncpack list",
    "deps:update": "syncpack update",
    "deps:update:check": "syncpack update --check",
    "dev": "turbo dev",
    "dev:docs": "turbo -F docs dev",
    "dev:server": "turbo -F server dev",
    "dev:web": "turbo -F web dev",
    "fetch": "bun run script/fetch.ts",
    "fix": "ultracite fix",
    "format": "ultracite fix",
    "graphql:schema": "bun run --filter @vyrel/graphql gen-schema",
    "knip": "knip",
    "knip:cycles": "knip --include cycles --reporter cycles",
    "knip:production": "knip --production",
    "lint": "ultracite check",
    "lint:doctor": "ultracite doctor",
    "preflight": "bun run deps:lint && bun run lint && turbo source --filter=docs && bun run knip && bun run knip:cycles && bun run check-types && bun run build && bun run test",
    "prepare": "bun run script/patch-ts6-imports.ts && husky",
    "processes:kill": "bun run script/kill-processes.ts",
    "release": "bun run script/release.ts",
    "rover": "bun run script/entry-point.ts",
    "scripts": "bun script/entry-point.ts",
    "test": "turbo test",
    "version-packages": "changeset version"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@vyrel/env": "workspace:*",
    "@vyrel/logging": "workspace:*",
    "add": "^2.0.9",
    "cz-git": "^1.13.1",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "evlog": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^21.2.0",
    "@effect/language-service": "catalog:",
    "@eslint/config-helpers": "^0.6.0",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@inquirer/confirm": "^6.1.1",
    "@inquirer/input": "^5.1.2",
    "@inquirer/select": "^5.2.1",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@vyrel/config": "workspace:*",
    "chalk": "^5.6.2",
    "czg": "^1.12.0",
    "eslint": "^10.6.0",
    "graphql-config": "^5.1.6",
    "husky": "^9.1.7",
    "knip": "^6.25.0",
    "syncpack": "^15.3.2",
    "tegami": "^1.2.3",
    "turbo": "^2.10.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.63.0",
    "typescript6": "catalog:",
    "ultracite": "7.9.2",
    "vercel": "^54.18.2"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@0no-co/graphqlsp@1.17.3": "patches/@0no-co%2Fgraphqlsp@1.17.3.patch"
  }
}
