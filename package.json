{
  "name": "vyrel",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "elysia": "^1.4.29",
      "better-auth": "^1.6.22",
      "graphql-yoga": "^5.21.2",
      "graphql": "^16.11.0",
      "@pothos/core": "^4.13.0",
      "react": "^19.2.7",
      "effect": "^3.21.4",
      "@effect/platform": "^0.96.2",
      "@types/react": "^19.2.17",
      "msw": "^2.14.6",
      "@effect/vitest": "^0.29.0",
      "vitest": "4.1.8",
      "@vitest/ui": "4.1.8",
      "@vitest/coverage-v8": "4.1.8",
      "jsdom": "^29.1.1",
      "@playwright/test": "^1.61.1",
      "playwright": "^1.61.1",
      "next": "^16.2.9",
      "react-dom": "^19.2.7",
      "@libsql/client": "^0.17.4",
      "libsql": "^0.5.29",
      "@tailwindcss/postcss": "^4.3.1",
      "tailwindcss": "^4.3.1",
      "@types/node": "^26.0.1",
      "@types/react-dom": "^19.2.3",
      "@effect/language-service": "^0.86.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:docs": "turbo -F docs dev",
    "build:docs": "turbo -F docs build",
    "check:docs": "turbo -F docs check-types",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @vyrel/db db:push",
    "db:studio": "turbo -F @vyrel/db db:studio",
    "db:generate": "turbo -F @vyrel/db db:generate",
    "db:migrate": "turbo -F @vyrel/db db:migrate",
    "db:local": "turbo -F @vyrel/db db:local",
    "test": "bun run --filter web test && bun run --filter server test && bun run --filter @vyrel/api test",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "lint:doctor": "ultracite doctor",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "deps:lint": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "deps:format:check": "syncpack format --check",
    "deps:list": "syncpack list",
    "deps:update": "syncpack update",
    "deps:update:check": "syncpack update --check",
    "knip": "knip",
    "knip:production": "knip --production",
    "scripts": "bun script/entry-point.ts",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": "ultracite fix"
  },
  "dependencies": {
    "@vyrel/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@effect/language-service": "catalog:",
    "@inquirer/confirm": "^6.1.1",
    "@inquirer/select": "^5.2.1",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@vyrel/config": "workspace:*",
    "chalk": "^5.6.2",
    "husky": "^9.1.7",
    "knip": "^6.25.0",
    "lint-staged": "^17.0.8",
    "syncpack": "^15.3.2",
    "tegami": "^1.2.3",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "ultracite": "7.9.3",
    "vercel": "^54.18.2"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "packageManager": "bun@1.3.14"
}
