{
  "name": "@vyrel/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./hooks/*": "./src/hooks/*",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "effect:codegen": "effect-language-service codegen --project tsconfig.json",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json --format text",
    "effect:overview": "effect-language-service overview --project tsconfig.json",
    "effect:quickfixes": "effect-language-service quickfixes --project tsconfig.json",
    "ui:add": "bunx --bun shadcn@latest add"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "date-fns": "catalog:",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@vyrel/config": "workspace:*",
    "typescript": "catalog:"
  }
}
