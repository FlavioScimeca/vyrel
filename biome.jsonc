{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "files": {
    "includes": [
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/.vercel",
      "!!**/.wrangler",
      "!!**/coverage",
      "!!**/.agents",
      "!!**/.claude",
      "!!**/.cursor",
      "!!**/graphql-env.d.ts"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentTypeDefinitions": "error"
      },
      "performance": {
        "noBarrelFile": "error"
      }
    }
  }
}
