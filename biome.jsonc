{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!!**/node_modules",
      "!!**/.git",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/.vercel",
      "!!**/.wrangler",
      "!!**/coverage",
      "!!**/.agents",
      "!!**/.claude",
      "!!**/.cursor",
      "!!**/.source",
      "!!**/.wxt",
      "!!**/graphql-env.d.ts",
      "!!apps/web/schema.graphql",
      "!!packages/graphql/gen/generated-imports.ts",
      "!!apps/web/src/components/ui",
      "!!apps/web/src/hooks/use-mobile.ts",
      "!!apps/mobile/assets",
      "!!apps/mobile/src/uniwind-types.d.ts"
    ]
  },
  "javascript": {
    "globals": ["Bun", "defineBackground", "defineContentScript", "browser"],
    "experimentalEmbeddedSnippetsEnabled": true
  },
  "linter": {
    "domains": {
      "types": "recommended"
    },
    "rules": {
      "style": {
        "useConsistentTypeDefinitions": "off"
      },
      "performance": {
        "noBarrelFile": "error",
        // React Compiler handles callback stability; react-doctor forbids manual useCallback.
        "noJsxPropsBind": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "json": {
    "assist": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["**/package.json"],
      "assist": {
        "actions": {
          "source": {
            "useSortedPackageJson": "on"
          }
        }
      }
    },
    {
      "includes": ["packages/logging/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "noExportedImports": "off"
          }
        }
      }
    }
  ]
}
