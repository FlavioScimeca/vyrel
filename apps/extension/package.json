{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "description": "vyrel browser extension",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "check-effect-ts": "effect-language-service diagnostics --project tsconfig.json --format text",
    "check-types": "wxt prepare && tsc --noEmit",
    "compile": "bun run check-types",
    "dev": "wxt --port 5555",
    "dev:firefox": "wxt -b firefox",
    "postinstall": "wxt prepare",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@vyrel/logging": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "catalog:",
    "wxt": "^0.20.27"
  }
}
