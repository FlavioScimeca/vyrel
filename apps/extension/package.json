{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "description": "vyrel browser extension",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "check-effect-ts": "effect-language-service diagnostics --project tsconfig.json --format text",
    "check-types": "wxt prepare && tsc --noEmit",
    "compile": "bun run check-types",
    "dev": "wxt --port 5555",
    "dev:firefox": "wxt -b firefox",
    "gql:client": "bun run --cwd ../.. --filter @vyrel/graphql-client build && graphql-codegen --config codegen.ts",
    "gql:generate": "gql-tada generate-output --tsconfig tsconfig.json",
    "postinstall": "wxt prepare",
    "ui:add": "bunx --bun shadcn@latest add",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@base-ui/react": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@tabler/icons-react": "catalog:",
    "@vyrel/api": "workspace:*",
    "@vyrel/env": "workspace:*",
    "@vyrel/graphql-client": "workspace:*",
    "@vyrel/logging": "workspace:*",
    "@vyrel/shared": "workspace:*",
    "better-auth": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "gql.tada": "catalog:",
    "graphql": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "shadcn": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "catalog:",
    "wxt": "^0.20.27"
  }
}
