{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "description": "vyrel browser extension",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "check-effect-ts": "effect-language-service diagnostics --project tsconfig.json --format text",
    "check-types": "wxt prepare && tsc --noEmit",
    "compile": "bun run check-types",
    "dev": "wxt --port 5555",
    "dev:firefox": "wxt -b firefox",
    "postinstall": "wxt prepare",
    "ui:add": "bunx --bun shadcn@latest add",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@shadcn/react": "^0.2.1",
    "@vyrel/logging": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "react": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-dom": "catalog:",
    "react-resizable-panels": "^4.12.1",
    "recharts": "3.8.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "catalog:",
    "wxt": "^0.20.27"
  }
}
