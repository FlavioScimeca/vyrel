{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "bun run script/prebuild.ts",
    "build": "bunx next build",
    "build-storybook": "storybook build",
    "check-types": "tsc --noEmit",
    "predev": "bun run graphql:schema && bun run gql:generate && bun run gql:client",
    "dev": "concurrently --kill-others --names next,gql-client \"bun run next dev --port 3001\" \"bun run gql:client:watch\"",
    "gql:client": "bun run --cwd ../.. --filter @vyrel/graphql-client build && graphql-codegen --config codegen.ts",
    "gql:client:watch": "graphql-codegen --config codegen.ts --watch",
    "gql:generate": "gql-tada generate-output --tsconfig tsconfig.json",
    "graphql:schema": "bun run --cwd ../.. graphql:schema",
    "react:doctor": "react-doctor --json --json-out react-doctor-report.json --yes",
    "react:doctor-base": "react-doctor",
    "start": "bun run next start --port 3001",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --passWithNoTests",
    "ui:add": "bunx --bun shadcn@latest add"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@base-ui/react": "^1.6.0",
    "@elysia/eden": "^1.4.10",
    "@hookform/resolvers": "^5.4.0",
    "@libsql/client": "catalog:",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.44.0",
    "@vyrel/api": "workspace:*",
    "@vyrel/consts": "workspace:*",
    "@vyrel/env": "workspace:*",
    "@vyrel/graphql-client": "workspace:*",
    "@vyrel/logging": "workspace:*",
    "@vyrel/shared": "workspace:*",
    "apollo-upload-client": "^19.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gql.tada": "^1.11.2",
    "graphql": "catalog:",
    "libsql": "catalog:",
    "motion": "^12.42.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.82.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@playwright/test": "catalog:",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/nextjs": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@vyrel/config": "workspace:*",
    "concurrently": "^9.2.1",
    "elysia": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "playwright": "catalog:",
    "react-doctor": "catalog:",
    "server": "workspace:*",
    "storybook": "^8.6.18",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
