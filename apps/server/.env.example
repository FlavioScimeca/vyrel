# Copy to `.env` and fill in real values:
#   cp apps/server/.env.example apps/server/.env

# --- Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-characters!!
BETTER_AUTH_URL=http://localhost:3000

# Web app origin (Better Auth trustedOrigins + CORS)
CORS_ORIGIN=http://localhost:3001

# Comma-separated extension origins (required in production when using the extension)
# EXTENSION_ORIGINS=chrome-extension://your-extension-id

# Dev-only: public Tailscale Funnel HTTPS URL (CORS + Better Auth trustedOrigins)
# From `bun run --cwd apps/server dev:tailscale` / `tailscale funnel status`
# TAILSCALE_FUNNEL_URL=https://<your-machine>.ts.net

# --- Database (libSQL / Turso) ---
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=local-dev-token

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# R2_JURISDICTION=eu
# R2_SIGNED_URL_TTL_SECONDS=3600

# --- Logging / runtime ---
LOG_LEVEL=info
# NODE_ENV=development
# PORT=3000
# MEDIA_MAX_UPLOAD_BYTES=104857600
# PROFILING=false
# PROFILE_SQL_LIMIT=20

# --- Redis / BullMQ (optional local defaults) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
