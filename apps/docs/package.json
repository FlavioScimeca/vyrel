{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun run --cwd ../.. script/swap-typescript-for-vercel.ts",
    "build": "bunx next build",
    "check-types": "tsc --noEmit",
    "dev": "next dev --port 4000",
    "effect:codegen": "effect-language-service codegen --project tsconfig.json",
    "effect:diagnostics": "effect-tsgo diagnostics --project tsconfig.json --format text",
    "effect:overview": "effect-language-service overview --project tsconfig.json",
    "effect:quickfixes": "effect-language-service quickfixes --project tsconfig.json",
    "source": "fumadocs-mdx",
    "start": "next start"
  },
  "dependencies": {
    "@vyrel/logging": "workspace:*",
    "fumadocs-core": "^16.10.6",
    "fumadocs-mdx": "^15.0.13",
    "fumadocs-ui": "^16.10.6",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.15",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
