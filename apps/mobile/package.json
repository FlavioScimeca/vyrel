{
  "name": "vyrel-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "check-types": "tsc --noEmit",
    "eas:configure": "eas build:configure",
    "eas:dev-android": "eas build --profile development --platform android",
    "eas:preview-android": "eas build --profile preview --platform android",
    "eas:production-android": "eas build --profile production --platform android",
    "expo:doctor": "bun x expo-doctor@latest",
    "expo:install-check": "bun x expo install --check",
    "gql:client": "bun run --cwd ../.. --filter @vyrel/graphql-client build && graphql-codegen --config codegen.ts",
    "gql:generate": "gql-tada generate-output --tsconfig tsconfig.json",
    "ios": "expo run:ios",
    "prebuild": "bun x expo prebuild",
    "start": "expo start",
    "web": "expo start --web"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@better-auth/expo": "^1.6.25",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~57.0.7",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@vyrel/env": "workspace:*",
    "@vyrel/graphql-client": "workspace:*",
    "better-auth": "catalog:",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "^57.0.6",
    "expo-linking": "~57.0.3",
    "expo-local-authentication": "^57.0.2",
    "expo-network": "^57.0.1",
    "expo-router": "~57.0.7",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.8",
    "expo-web-browser": "~57.0.1",
    "gql.tada": "^1.11.2",
    "graphql": "catalog:",
    "heroui-native": "^1.0.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.82.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-keyboard-controller": "^1.22.2",
    "react-native-reanimated": "^4.1.1",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "catalog:",
    "uniwind": "^1.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@types/react": "catalog:",
    "eas-cli": "^21.2.0",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "typescript"
      ]
    }
  }
}
