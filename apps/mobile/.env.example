# Preferred for physical devices (4G/5G or any network): Tailscale Funnel
# public HTTPS URL from `bun run --cwd apps/server dev:tailscale`
# (or `tailscale funnel status`). No :3000 — Funnel terminates TLS on 443.
# EXPO_PUBLIC_SERVER_URL=https://flavios-macbook-pro.tailf1b5e4.ts.net

# Android emulator only: 10.0.2.2 is NOT your Mac's Wi‑Fi IP.
# It is a special address inside the emulator that maps to the host
# (your Mac's localhost:3000). `ipconfig getifaddr en0` will show
# something like 10.x.x.x — that is for physical devices, not the emulator.
EXPO_PUBLIC_SERVER_URL=http://10.0.2.2:3000

# Physical device (same Wi‑Fi as the Mac): use the Mac LAN IP
#   ipconfig getifaddr en0
# EXPO_PUBLIC_SERVER_URL=http://10.224.159.57:3000

# iOS simulator: localhost is fine (shares the Mac network stack)
# EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Local APK publish (`bun run publish:apk`) → GitHub Releases bucket
# Public repo: https://github.com/FlavioScimeca/my-bucket
BUCKET_REPO=FlavioScimeca/my-bucket
# APK_NAME=app-dev.apk
